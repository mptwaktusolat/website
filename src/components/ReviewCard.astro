---
import { Image } from "astro:assets";
import { Star } from "@lucide/astro";
import type { ImageMetadata } from "astro";

interface Props {
  quote: string;
  name: string;
  avatar: ImageMetadata;
  prominent?: boolean;
  class?: string;
}

const {
  quote,
  name,
  avatar,
  prominent = false,
  class: className = "",
} = Astro.props;
---

<figure
  class:list={[
    "flex flex-col justify-between rounded-2xl bg-(--card-bg) p-6 shadow-lg shadow-black/5",
    prominent ? "min-h-[306px] lg:p-12" : "min-h-[180px]",
    className,
  ]}
>
  <blockquote
    class:list={[
      "font-medium leading-relaxed text-(--text-primary)",
      prominent
        ? "text-lg lg:text-[22px] lg:leading-[1.55]"
        : "text-sm lg:text-[15px]",
    ]}
  >
    “{quote}”
  </blockquote>
  <figcaption class="mt-8 flex items-center gap-4">
    <Image
      src={avatar}
      alt=""
      width={40}
      height={40}
      class="h-10 w-10 flex-none rounded-full object-cover"
      loading="lazy"
    />
    <div class="min-w-0">
      <span class="block text-xs font-semibold text-(--text-primary) lg:text-sm"
        >{name}</span
      >
      <span
        class="mt-1 flex gap-0.5 text-(--accent)"
        aria-label="5 out of 5 stars"
      >
        {
          Array.from({ length: 5 }).map(() => (
            <Star
              size={14}
              fill="currentColor"
              stroke-width={1.5}
              aria-hidden="true"
            />
          ))
        }
      </span>
    </div>
  </figcaption>
</figure>
