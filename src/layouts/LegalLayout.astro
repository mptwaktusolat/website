---
import { House } from "@lucide/astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | App Waktu Solat Malaysia | Malaysia Prayer Time App`}
  description={frontmatter.description}
>
  <main class="relative isolate min-h-screen overflow-hidden bg-(--page-bg)">
    <div
      class="hero-glow pointer-events-none absolute inset-x-0 top-[35%] h-[700px]"
      aria-hidden="true"
    >
    </div>

    <a
      href="/"
      class="absolute left-8 top-5 z-20 flex items-center rounded-md bg-(--card-bg)/80 px-3 py-2 text-sm font-medium text-(--text-primary) backdrop-blur-sm transition-colors hover:bg-(--card-bg) sm:left-10 sm:top-6"
    >
      <House
        size={20}
        fill="currentColor"
        stroke-width={1.5}
        class="mr-1"
        aria-hidden="true"
      />
      Home
    </a>

    <div class="absolute right-6 top-4 z-20 text-(--text-primary) lg:right-8">
      <ThemeToggle />
    </div>

    <div
      class="relative mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-32"
    >
      <div class="mx-auto max-w-4xl">
        <h1
          class="ml-3 mt-10 text-4xl font-bold tracking-tight text-(--text-primary) sm:text-6xl"
        >
          {frontmatter.title}
        </h1>
      </div>

      <article
        class="mx-auto mt-16 max-w-4xl text-base leading-6 text-(--text-primary) sm:mt-24 [&_a]:text-(--accent) [&_a]:hover:underline [&_h2]:mb-2 [&_h2]:mt-6 [&_h2]:text-3xl [&_h2]:font-medium [&_li]:mt-2 [&_li]:marker:text-(--text-subtle) [&_p]:mb-6 [&_p]:mt-2 [&_strong]:font-bold [&_ul]:mb-2 [&_ul]:list-disc [&_ul]:pl-12"
      >
        <slot />
      </article>
    </div>
  </main>
</Layout>
